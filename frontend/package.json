{
  "name": "dutylog-vue-frontend",
  "version": "27.34.1",
  "private": true,
  "type": "module",
  "description": "Vue 3 + TypeScript app shell and design system for DutyLog",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run --environment node",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173"
  },
  "dependencies": {
    "pinia": "2.3.0",
    "vue": "3.5.13",
    "vue-router": "4.5.0"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@vitejs/plugin-vue": "5.2.1",
    "typescript": "5.7.3",
    "vite": "5.4.14",
    "vitest": "2.1.8",
    "vue-tsc": "2.2.0"
  }
}
