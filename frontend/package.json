{
  "name": "dutylog-vue-frontend",
  "version": "27.47.0",
  "private": true,
  "type": "module",
  "description": "Vue 3 + strict TypeScript frontend for DutyLog",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": "20.18.1",
    "npm": "10.8.2"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "contract:generate": "node ./scripts/generate-openapi-contract.mjs",
    "contract:check": "node ./scripts/generate-openapi-contract.mjs --check",
    "verify:delivery": "node ./scripts/verify-delivery-foundation.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run --environment node",
    "build": "npm run verify:delivery && npm run contract:check && npm run typecheck && vite build && npm run audit:bundle",
    "preview": "vite preview --host 127.0.0.1 --port 5173",
    "audit:bundle": "node ./scripts/audit-browser-bundle.mjs"
  },
  "dependencies": {
    "pinia": "2.3.0",
    "vue": "3.5.13",
    "vue-router": "4.5.0"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@vitejs/plugin-vue": "5.2.1",
    "typescript": "5.7.3",
    "vite": "5.4.14",
    "vitest": "2.1.8",
    "vue-tsc": "2.2.0"
  }
}
