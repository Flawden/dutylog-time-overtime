# DutyLog staging behind the VPS-wide system nginx.
# Install once as /etc/nginx/sites-available/dutylog-staging, enable the symlink,
# test nginx, then run: certbot --nginx -d stage.yaruga-trophy.ru
#
# This file intentionally starts with HTTP only so Certbot can obtain the first
# certificate. Certbot adds the HTTPS server and redirect without touching Docker.

limit_req_zone $binary_remote_addr zone=dutylog_staging_auth:10m rate=5r/m;

server {
    listen 80;
    listen [::]:80;
    server_name stage.yaruga-trophy.ru;

    client_max_body_size 10m;

    # Defense in depth. DutyLog also rate-limits these endpoints internally.
    location ~ ^/(perform_login|api/auth/register|api/mobile/auth/login|api/v1/mobile/auth/login|api/v1/mobile/auth/register)$ {
        limit_req zone=dutylog_staging_auth burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:18082;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_read_timeout 60s;
        proxy_redirect off;
    }

    location / {
        proxy_pass http://127.0.0.1:18082;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Overwrite rather than append client-supplied forwarding headers.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_read_timeout 60s;
        proxy_redirect off;
    }
}
