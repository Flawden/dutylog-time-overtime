# Alternative nginx reverse proxy example.
# Caddy is recommended for first launch because it obtains HTTPS certificates automatically.

server {
    listen 80;
    server_name dutylog.example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name dutylog.example.com;

    # Fill these paths if you manage certificates yourself or via certbot.
    ssl_certificate /etc/letsencrypt/live/dutylog.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dutylog.example.com/privkey.pem;

    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
