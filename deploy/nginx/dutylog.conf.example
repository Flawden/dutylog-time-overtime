# Generic nginx reverse proxy example for other hosts.
# For the current shared YARUGA VPS use dutylog-staging.conf.example and dutylog-production.conf.example.
# DutyLog also enforces auth rate limits in the application. The nginx zone below is optional defense in depth.

# Зона для лимита попыток входа: ключ — IP, 5 запросов в минуту.
# Директива limit_req_zone живёт на уровне http {} — если этот файл
# подключается внутрь http (стандартный include в conf.d/), всё сработает как есть.
limit_req_zone $binary_remote_addr zone=dutylog_auth:10m rate=5r/m;

server {
    listen 80;
    server_name dutylog.example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Preserve the bearer query across HTTPS redirect, but never log it.
    location = /calendar-feed.ics {
        access_log off;
        return 301 https://$host$request_uri;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name dutylog.example.com;

    # Fill these paths if you manage certificates yourself or via certbot.
    ssl_certificate /etc/letsencrypt/live/dutylog.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dutylog.example.com/privkey.pem;

    client_max_body_size 10m;

    # Browser hardening parity with the Spring and Caddy policies.
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; manifest-src 'self'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'" always;

    # The feed token is a bearer secret in the query string. Never log its request line.
    location = /calendar-feed.ics {
        access_log off;
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Optional proxy-level defense in depth: login, registration and mobile login.
    # burst=5 — небольшая очередь на легитимные повторы, nodelay — без искусственной задержки.
    location ~ ^/(perform_login|api/auth/register|api/mobile/auth/login|api/v1/mobile/auth/login|api/v1/mobile/auth/register)$ {
        limit_req zone=dutylog_auth burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
}
