# DutyLog production environment template.
# Copy this file to .env on the VPS and fill real values.
# Never commit .env with real passwords/tokens.

# Public domain used by Caddy. Example: dutylog.example.com
DUTYLOG_DOMAIN=dutylog.example.com

# PostgreSQL
POSTGRES_DB=dutylog
POSTGRES_USER=dutylog
POSTGRES_PASSWORD=change_me_to_a_long_random_password

# Spring datasource. In docker-compose.prod.yml the database service is named db.
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/dutylog
SPRING_DATASOURCE_USERNAME=dutylog
SPRING_DATASOURCE_PASSWORD=change_me_to_the_same_or_dedicated_db_password


# Secure admin bootstrap. Public registration creates USER accounts only.
# The backend creates/updates this administrator on startup.
DUTYLOG_ADMIN_USERNAME=admin
DUTYLOG_ADMIN_PASSWORD=change_me_to_a_long_random_admin_password
DUTYLOG_ADMIN_FORCE_PASSWORD_RESET=false

# Public registration is controlled from admin UI: Система -> Публичная регистрация.
# This file does not create administrator accounts through public registration.

# Telegram bot. Keep disabled until BotFather token is configured.
DUTYLOG_TELEGRAM_ENABLED=false
DUTYLOG_TELEGRAM_BOT_TOKEN=
DUTYLOG_TELEGRAM_BOT_USERNAME=
DUTYLOG_TELEGRAM_POLLING_ENABLED=false
DUTYLOG_TELEGRAM_POLLING_DELAY_MS=3000

# Telegram reminder delivery.
DUTYLOG_TELEGRAM_NOTIFICATIONS_ENABLED=true
DUTYLOG_TELEGRAM_NOTIFICATION_SCAN_DELAY_MS=60000
DUTYLOG_TELEGRAM_NOTIFICATION_LOOKBACK_MINUTES=10
DUTYLOG_TELEGRAM_NOTIFICATION_LOOKAHEAD_MINUTES=1

# Request diagnostics logging: INFO, WARN, ERROR, OFF.
DUTYLOG_REQUEST_LOG_LEVEL=INFO

# Backup scripts.
BACKUP_DIR=./backups
BACKUP_KEEP_LAST=30
DUTYLOG_DB_SERVICE=db
DUTYLOG_APP_SERVICE=app
# Optional: set to docker-compose.prod.yml on VPS if backup scripts should always use prod compose.
DUTYLOG_COMPOSE_FILE=docker-compose.prod.yml

# Secure production defaults. Registration remains closed until an admin opens it in the UI.
DUTYLOG_REGISTRATION_DEFAULT_ENABLED=false

# App-level auth rate limiting (works behind both Caddy and nginx).
DUTYLOG_SECURITY_RATE_LIMIT_ENABLED=true
DUTYLOG_SECURITY_LOGIN_ATTEMPTS=5
DUTYLOG_SECURITY_LOGIN_WINDOW_SECONDS=60
DUTYLOG_SECURITY_REGISTRATION_ATTEMPTS=5
DUTYLOG_SECURITY_REGISTRATION_WINDOW_SECONDS=3600

# Notes export safety limits.
DUTYLOG_EXPORT_NOTES_MAX_COUNT=10000
DUTYLOG_EXPORT_NOTES_MAX_UNCOMPRESSED_BYTES=52428800

# Rolling application/security log inside the app_logs Docker volume.
DUTYLOG_LOG_FILE=/app/logs/dutylog.log
DUTYLOG_LOG_MAX_FILE_SIZE=10MB
DUTYLOG_LOG_MAX_HISTORY=14
DUTYLOG_LOG_TOTAL_SIZE_CAP=200MB

# Android API v1 idempotency ledger retention.
DUTYLOG_MOBILE_SYNC_RETENTION_DAYS=90
DUTYLOG_MOBILE_SYNC_CLEANUP_DELAY_MS=86400000
