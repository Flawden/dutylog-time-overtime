# Скопируй в .env и поменяй пароли перед запуском на сервере.
POSTGRES_DB=shift_calendar
POSTGRES_USER=shift_calendar
POSTGRES_PASSWORD=change_me_strong_password
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/shift_calendar
SPRING_DATASOURCE_USERNAME=shift_calendar
SPRING_DATASOURCE_PASSWORD=change_me_strong_password

# Secure admin bootstrap. Public registration creates USER accounts only.
# The backend creates/updates this administrator on startup.
DUTYLOG_ADMIN_USERNAME=admin
DUTYLOG_ADMIN_PASSWORD=change_me_to_a_long_random_admin_password
DUTYLOG_ADMIN_FORCE_PASSWORD_RESET=false

# Public registration is controlled from admin UI: Система -> Публичная регистрация.
# This file does not create administrator accounts through public registration.

# Telegram bot, optional. Create token in @BotFather.
DUTYLOG_TELEGRAM_ENABLED=false
DUTYLOG_TELEGRAM_BOT_TOKEN=
DUTYLOG_TELEGRAM_BOT_USERNAME=
DUTYLOG_TELEGRAM_POLLING_ENABLED=false
DUTYLOG_TELEGRAM_POLLING_DELAY_MS=3000
DUTYLOG_TELEGRAM_COMMAND_MENU_ENABLED=true
DUTYLOG_TELEGRAM_COMMAND_MENU_INITIAL_DELAY_MS=7000
DUTYLOG_TELEGRAM_COMMAND_MENU_REFRESH_MS=21600000

# Telegram notifications: backend sends due reminders to linked chats.
DUTYLOG_TELEGRAM_NOTIFICATIONS_ENABLED=true
DUTYLOG_TELEGRAM_NOTIFICATION_SCAN_DELAY_MS=60000
DUTYLOG_TELEGRAM_NOTIFICATION_LOOKBACK_MINUTES=10
DUTYLOG_TELEGRAM_NOTIFICATION_LOOKAHEAD_MINUTES=1

# Diagnostics logging level for API request logs: INFO, WARN, ERROR, OFF
DUTYLOG_REQUEST_LOG_LEVEL=INFO

# Persistent browser login (checkbox on login page).
DUTYLOG_REMEMBER_ME_VALIDITY_DAYS=30
# true on HTTPS staging/production; false only for local HTTP development.
DUTYLOG_REMEMBER_ME_SECURE_COOKIE=true

# Backup scripts, optional
BACKUP_DIR=./backups
BACKUP_KEEP_LAST=20
BACKUP_MAX_AGE_HOURS=30
DUTYLOG_BACKUP_REQUIRE_CHECKSUM=true
DUTYLOG_BACKUP_VALIDATE_ARCHIVE=true
DUTYLOG_RESTORE_REQUIRE_CHECKSUM=true
DUTYLOG_DB_SERVICE=db
DUTYLOG_APP_SERVICE=app
# Optional override. Active staging/production defaults to deploy/compose/docker-compose.deploy.yml.
DUTYLOG_COMPOSE_FILE=

# Production reverse proxy domain, used by docker-compose.prod.yml + Caddy.
DUTYLOG_DOMAIN=dutylog.example.com

# Android API v1 idempotency ledger retention.
DUTYLOG_MOBILE_SYNC_RETENTION_DAYS=90
DUTYLOG_MOBILE_SYNC_CLEANUP_DELAY_MS=86400000
