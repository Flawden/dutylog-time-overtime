# Скопируй в .env и поменяй пароли перед запуском на сервере.
POSTGRES_DB=shift_calendar
POSTGRES_USER=shift_calendar
POSTGRES_PASSWORD=change_me_strong_password
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/shift_calendar
SPRING_DATASOURCE_USERNAME=shift_calendar
SPRING_DATASOURCE_PASSWORD=change_me_strong_password

# Telegram bot, optional. Create token in @BotFather.
DUTYLOG_TELEGRAM_ENABLED=false
DUTYLOG_TELEGRAM_BOT_TOKEN=
DUTYLOG_TELEGRAM_BOT_USERNAME=
DUTYLOG_TELEGRAM_POLLING_ENABLED=false
DUTYLOG_TELEGRAM_POLLING_DELAY_MS=3000
